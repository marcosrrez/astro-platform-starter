---
import Layout from '../layouts/Layout.astro';

const title = "About Florecer Mind - Where Research Blooms into Wisdom";
const description = "Learn about our mission to transform complex academic research into accessible, practical wisdom for everyday people and counselors.";
---

<Layout title={title} description={description}>
    <div class="max-w-4xl mx-auto">
        <!-- Mission Statement -->
        <section class="mb-16">
            <h1 class="mb-6 optical-align">
                Where Research Blooms into Wisdom
            </h1>

            <p class="mb-6 text-xl text-neutral-700 leading-relaxed">
                We transform complex academic research from counseling, neuroscience, and cognitive science
                into accessible, practical wisdom for everyday people and counselors.
            </p>

            <p class="text-lg text-neutral-700 leading-relaxed">
                Our mission is to rescue valuable research from academic obscurity and help it flourish in real lives.
            </p>
        </section>

        <!-- The Problem -->
        <section class="mb-16 p-8 card-surface-muted border-l-4 border-l-primary">
            <h2 class="mb-4 text-2xl font-bold text-primary">The Problem We're Solving</h2>
            <p class="mb-4 text-neutral-700 leading-relaxed">
                Groundbreaking research in psychology, neuroscience, and cognitive science is being published
                every day. Studies that could transform how we understand ourselves, heal from trauma, build
                resilience, and live more fulfilling lives.
            </p>
            <p class="text-neutral-700 leading-relaxed">
                But this research often stays trapped in academic journals, written in technical language,
                hidden behind paywalls, and inaccessible to the very people who could benefit from it most.
            </p>
        </section>

        <!-- Our Approach -->
        <section class="mb-16">
            <h2 class="mb-6 text-3xl font-bold text-primary">Our Approach</h2>

            <div class="grid gap-6 md:grid-cols-2">
                <div class="p-6 card-surface">
                    <h3 class="mb-3 text-xl font-bold text-neutral-900">Evidence-Based</h3>
                    <p class="text-neutral-700">
                        Every insight we share is grounded in peer-reviewed research. We cite our sources and
                        explain the methodology so you can trust what you're learning.
                    </p>
                </div>

                <div class="p-6 card-surface">
                    <h3 class="mb-3 text-xl font-bold text-neutral-900">Accessible</h3>
                    <p class="text-neutral-700">
                        We translate academic jargon into clear, conversational language. Complex concepts become
                        understandable without losing their scientific accuracy.
                    </p>
                </div>

                <div class="p-6 card-surface">
                    <h3 class="mb-3 text-xl font-bold text-neutral-900">Practical</h3>
                    <p class="text-neutral-700">
                        Every research spotlight includes actionable takeaways. We bridge the gap between
                        "interesting findings" and "what do I do with this information?"
                    </p>
                </div>

                <div class="p-6 card-surface">
                    <h3 class="mb-3 text-xl font-bold text-neutral-900">Inclusive</h3>
                    <p class="text-neutral-700">
                        Our content serves both everyday people seeking personal growth and counselors deepening
                        their practice. Everyone benefits from understanding the science of human flourishing.
                    </p>
                </div>
            </div>
        </section>

        <!-- What We Cover -->
        <section class="mb-16">
            <h2 class="mb-6 text-3xl font-bold text-primary">What We Cover</h2>

            <div class="space-y-4">
                <div class="p-6 card-surface-muted">
                    <h3 class="mb-2 text-lg font-bold text-neutral-900">Counseling &amp; Therapy Research</h3>
                    <p class="text-neutral-700">
                        What makes therapy effective? How do different therapeutic approaches work? What does
                        the science say about healing and growth?
                    </p>
                </div>

                <div class="p-6 card-surface-muted">
                    <h3 class="mb-2 text-lg font-bold text-neutral-900">Neuroscience</h3>
                    <p class="text-neutral-700">
                        How does your brain change and adapt? What do we know about neuroplasticity, memory,
                        emotion regulation, and stress response?
                    </p>
                </div>

                <div class="p-6 card-surface-muted">
                    <h3 class="mb-2 text-lg font-bold text-neutral-900">Cognitive Science &amp; Child Development</h3>
                    <p class="text-neutral-700">
                        How do children and adults think, learn, and build executive function? What insights help us honor the creaturely limits of a developing brain?
                    </p>
                </div>
            </div>
        </section>

        <!-- Content Types -->
        <section class="mb-16">
            <h2 class="mb-6 text-3xl font-bold text-primary">How We Share Knowledge</h2>

            <div class="space-y-6">
                <article class="p-6 card-surface">
                    <h3 class="mb-2 text-xl font-bold text-neutral-900">Research Spotlights &amp; The Embodied Soul Series</h3>
                    <p class="text-neutral-700">
                        Deep-dives into specific studies and developmental neuroscience. We break down the findings, explain the mechanisms, and provide practical scripts for your home or clinical playroom.
                    </p>
                </article>

                <article class="p-6 card-surface">
                    <h3 class="mb-2 text-xl font-bold text-neutral-900">Newsletter: Research Rescue Weekly</h3>
                    <p class="text-neutral-700">
                        Get evidence-based insights delivered to your inbox. Concise dispatches with actionable
                        takeaways, no jargon, just practical wisdom.
                    </p>
                </article>
            </div>
        </section>

        <!-- Who's Behind Florecer Mind + Methodology -->
        <section class="mb-16">
            <h2 class="mb-6 text-3xl font-bold text-primary">Who's Behind Florecer Mind</h2>
            <div class="p-8 card-surface">
                <p class="text-neutral-700 leading-relaxed">
                    Florecer Mind is founded and edited by <strong class="text-neutral-900">Marcos Gutierrez, LAC</strong>,
                    a Licensed Associate Counselor. Everything we publish goes out under the Florecer Mind
                    name and is personally reviewed against its primary sources before it goes live.
                </p>
            </div>

            <h3 class="mt-10 mb-4 text-xl font-bold text-neutral-900">How we research &amp; verify</h3>
            <div class="space-y-3 text-neutral-700">
                <p class="flex items-start">
                    <span class="font-bold text-primary mr-2">→</span>
                    <span>We start from <strong>peer-reviewed research</strong> (meta-analyses, systematic reviews, and primary studies), not second-hand summaries.</span>
                </p>
                <p class="flex items-start">
                    <span class="font-bold text-primary mr-2">→</span>
                    <span>Each spotlight is <strong>researched and drafted with AI assistance</strong>, which lets us cover more ground without cutting corners on rigor.</span>
                </p>
                <p class="flex items-start">
                    <span class="font-bold text-primary mr-2">→</span>
                    <span>Before publishing, every specific claim is <strong>human-reviewed against the cited source</strong>. If a claim can't be verified, we reword it or remove it.</span>
                </p>
                <p class="flex items-start">
                    <span class="font-bold text-primary mr-2">→</span>
                    <span>We link the <strong>primary source</strong> for every named study, so you can always check our work.</span>
                </p>
            </div>
        </section>

        <!-- Get in Touch -->
        <section class="mb-16">
            <h2 class="mb-6 text-3xl font-bold text-primary">Get in Touch</h2>
            <div class="p-8 card-surface">
                <p class="mb-5 text-neutral-700 leading-relaxed">
                    Have questions, feedback, or suggestions for research topics to cover?
                    We'd love to hear from you.
                </p>
                <a
                    href="mailto:marcos@getflorecer.com"
                    class="btn btn-secondary"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                    <span>marcos@getflorecer.com</span>
                </a>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="on-dark p-8 sm:p-12 text-center rounded-[20px] bg-primary">
            <h2 class="mb-4 text-3xl font-bold">Join Us in Making Research Bloom</h2>
            <p class="mb-8 text-lg max-w-2xl mx-auto">
                Whether you're seeking personal growth or professional development, you'll find
                evidence-based wisdom that can transform your understanding and practice.
            </p>
            <div class="flex flex-wrap gap-3.5 justify-center">
                <a href="/blog" class="btn btn-inverse btn-lg">
                    Explore Research
                </a>
                <a href="/newsletter" class="btn btn-outline-inverse btn-lg">
                    Subscribe to Newsletter
                </a>
            </div>
        </section>
    </div>
</Layout>
