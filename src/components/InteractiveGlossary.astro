---
import { GLOSSARY } from '../data/glossary';

interface Props {
    showFullGrid?: boolean;
    enableInlineHighlighting?: boolean;
}

const { showFullGrid = true, enableInlineHighlighting = true } = Astro.props;

const categories = [...new Set(GLOSSARY.map((item) => item.category))];
---

{enableInlineHighlighting && (
    <div class="my-6 p-4 rounded-lg bg-primary/5 border border-primary/20 flex items-start gap-3 font-sans text-sm text-neutral-700">
        <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
        </svg>
        <div>
            <strong class="text-neutral-900">Interactive Study Mode:</strong> Scientific and philosophical terms underlined in this essay are interactive. Click or tap any underlined word to open its plain-English definition, a C.S. Lewis everyday illustration, and a practical parenting and counseling example.
        </div>
    </div>
)}

{showFullGrid && (
    <section class="mt-14 pt-10 border-t border-neutral-200 font-sans" id="interactive-glossary">
        <div class="mb-6">
            <p class="kicker mb-2">Interactive Lexicon</p>
            <h2 class="font-serif text-2xl sm:text-3xl text-neutral-900 mb-2">
                Click Any Concept to Learn with Illustrations & Examples
            </h2>
            <p class="text-neutral-700 leading-relaxed max-w-2xl">
                Every scientific mechanism in this series is paired with a plain-English definition, a vivid C.S. Lewis-style metaphor, and a concrete application for your home and clinical playroom.
            </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {GLOSSARY.map((item) => (
                <button
                    type="button"
                    data-term-id={item.id}
                    class="glossary-card-trigger text-left p-5 rounded-lg bg-white border border-neutral-200 hover:border-primary hover:shadow-md transition-all group flex flex-col justify-between"
                >
                    <div>
                        <span class="inline-block text-xs font-semibold uppercase tracking-wider text-primary mb-1.5">
                            {item.category}
                        </span>
                        <h3 class="font-serif text-lg font-bold text-neutral-900 group-hover:text-primary transition-colors mb-2">
                            {item.term}
                        </h3>
                        <p class="text-xs text-neutral-600 line-clamp-3 leading-relaxed">
                            {item.definition}
                        </p>
                    </div>
                    <span class="mt-4 inline-flex items-center text-xs font-semibold text-primary group-hover:translate-x-0.5 transition-transform">
                        Open illustration & example →
                    </span>
                </button>
            ))}
        </div>
    </section>
)}

<!-- Interactive Concept Popover Modal -->
<div
    id="glossaryModalBackdrop"
    class="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs hidden items-center justify-center p-4 sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-labelledby="glossaryModalTitle"
>
    <div class="bg-[#FAFAF9] border border-neutral-300 rounded-xl max-w-xl w-full max-h-[86vh] overflow-y-auto shadow-2xl p-6 sm:p-8 relative font-sans">
        <button
            type="button"
            id="glossaryModalClose"
            class="absolute top-4 right-4 w-9 h-9 rounded-full bg-neutral-200/80 hover:bg-neutral-300 text-neutral-800 flex items-center justify-center font-bold transition-colors"
            aria-label="Close concept explanation"
        >
            ✕
        </button>

        <div id="glossaryModalCategory" class="text-xs font-bold uppercase tracking-widest text-primary mb-1"></div>
        <h3 id="glossaryModalTitle" class="font-serif text-2xl sm:text-3xl font-bold text-neutral-900 mb-5 pr-8"></h3>

        <div class="space-y-5">
            <div class="p-4 rounded-lg bg-white border border-neutral-200">
                <div class="text-xs font-bold uppercase tracking-wider text-neutral-500 mb-1.5">
                    1. Plain-English Definition
                </div>
                <p id="glossaryModalDefinition" class="text-neutral-800 text-sm sm:text-base leading-relaxed"></p>
            </div>

            <div class="p-4 rounded-lg bg-primary/5 border-l-4 border-primary">
                <div class="text-xs font-bold uppercase tracking-wider text-primary mb-1.5">
                    2. The C.S. Lewis Picture (Illustration)
                </div>
                <p id="glossaryModalIllustration" class="font-serif italic text-neutral-900 text-base sm:text-lg leading-relaxed"></p>
            </div>

            <div class="p-4 rounded-lg bg-neutral-100 border border-neutral-200">
                <div class="text-xs font-bold uppercase tracking-wider text-neutral-700 mb-1.5">
                    3. At Home & In the Playroom (Example)
                </div>
                <p id="glossaryModalExample" class="text-neutral-800 text-sm sm:text-base leading-relaxed"></p>
            </div>

            <div id="glossaryModalRelatedSection" class="pt-2">
                <div class="text-xs font-bold uppercase tracking-wider text-neutral-500 mb-2">
                    Connected Concepts (Tap to Explore)
                </div>
                <div id="glossaryModalRelatedList" class="flex flex-wrap gap-2"></div>
            </div>
        </div>
    </div>
</div>

<style is:global>
    .glossary-inline-term {
        display: inline;
        background: rgba(45, 90, 61, 0.07);
        border-bottom: 1.5px dashed #2d5a3d;
        color: inherit;
        font-weight: 600;
        padding: 0 3px;
        border-radius: 3px;
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease;
    }
    .glossary-inline-term:hover,
    .glossary-inline-term:focus {
        background: rgba(45, 90, 61, 0.18);
        color: #1e3f2a;
        outline: none;
    }
</style>

<script define:vars={{ GLOSSARY, enableInlineHighlighting }}>
    const glossaryById = new Map(GLOSSARY.map((item) => [item.id, item]));
    const glossaryByTermLower = new Map(GLOSSARY.map((item) => [item.term.toLowerCase(), item]));

    function openGlossaryModal(termId) {
        const entry = glossaryById.get(termId);
        if (!entry) return;

        const backdrop = document.getElementById('glossaryModalBackdrop');
        const catEl = document.getElementById('glossaryModalCategory');
        const titleEl = document.getElementById('glossaryModalTitle');
        const defEl = document.getElementById('glossaryModalDefinition');
        const illEl = document.getElementById('glossaryModalIllustration');
        const exEl = document.getElementById('glossaryModalExample');
        const relList = document.getElementById('glossaryModalRelatedList');

        if (!backdrop || !titleEl) return;

        catEl.textContent = entry.category;
        titleEl.textContent = entry.term;
        defEl.textContent = entry.definition;
        illEl.textContent = entry.illustration;
        exEl.textContent = entry.example;

        if (relList) {
            relList.innerHTML = '';
            (entry.related || []).forEach((relName) => {
                const target =
                    glossaryByTermLower.get(relName.toLowerCase()) ||
                    GLOSSARY.find((g) => g.term.toLowerCase().includes(relName.toLowerCase()));
                if (target) {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className =
                        'px-3 py-1 rounded-full text-xs font-semibold bg-white border border-neutral-300 text-neutral-800 hover:border-primary hover:text-primary transition-colors';
                    btn.textContent = target.term;
                    btn.addEventListener('click', () => openGlossaryModal(target.id));
                    relList.appendChild(btn);
                }
            });
        }

        backdrop.classList.remove('hidden');
        backdrop.classList.add('flex');
    }

    function closeGlossaryModal() {
        const backdrop = document.getElementById('glossaryModalBackdrop');
        if (!backdrop) return;
        backdrop.classList.add('hidden');
        backdrop.classList.remove('flex');
    }

    function initGlossaryInteractions() {
        const backdrop = document.getElementById('glossaryModalBackdrop');
        const closeBtn = document.getElementById('glossaryModalClose');

        closeBtn?.addEventListener('click', closeGlossaryModal);
        backdrop?.addEventListener('click', (e) => {
            if (e.target === backdrop) closeGlossaryModal();
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeGlossaryModal();
        });

        // Bind grid cards
        document.querySelectorAll('.glossary-card-trigger').forEach((btn) => {
            btn.addEventListener('click', () => {
                const id = btn.getAttribute('data-term-id');
                if (id) openGlossaryModal(id);
            });
        });

        if (!enableInlineHighlighting) return;

        const prose = document.querySelector('.prose');
        if (!prose) return;

        // Build ordered matchers (longest phrases first)
        const matchEntries = [];
        GLOSSARY.forEach((item) => {
            (item.matches || [item.term]).forEach((phrase) => {
                matchEntries.push({ phrase, id: item.id, len: phrase.length });
            });
        });
        matchEntries.sort((a, b) => b.len - a.len);

        const escapedPhrases = matchEntries.map((m) =>
            m.phrase.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
        );
        const masterRegex = new RegExp(`\\b(${escapedPhrases.join('|')})\\b`, 'gi');

        const walker = document.createTreeWalker(prose, NodeFilter.SHOW_TEXT, {
            acceptNode(node) {
                const parent = node.parentElement;
                if (!parent) return NodeFilter.FILTER_REJECT;
                const tag = parent.tagName.toLowerCase();
                if (['a', 'button', 'h1', 'h2', 'h3', 'h4', 'code', 'pre', 'script', 'style'].includes(tag)) {
                    return NodeFilter.FILTER_REJECT;
                }
                if (parent.closest('.glossary-inline-term')) {
                    return NodeFilter.FILTER_REJECT;
                }
                if (node.nodeValue && masterRegex.test(node.nodeValue)) {
                    masterRegex.lastIndex = 0;
                    return NodeFilter.FILTER_ACCEPT;
                }
                return NodeFilter.FILTER_SKIP;
            }
        });

        const textNodes = [];
        let current;
        while ((current = walker.nextNode())) {
            textNodes.push(current);
        }

        textNodes.forEach((textNode) => {
            const text = textNode.nodeValue;
            if (!text) return;
            masterRegex.lastIndex = 0;
            let lastIdx = 0;
            let match;
            const frag = document.createDocumentFragment();
            let replacedAny = false;

            while ((match = masterRegex.exec(text)) !== null) {
                const matchedWord = match[0];
                const entry = matchEntries.find(
                    (m) => m.phrase.toLowerCase() === matchedWord.toLowerCase()
                );
                if (!entry) continue;

                if (match.index > lastIdx) {
                    frag.appendChild(document.createTextNode(text.slice(lastIdx, match.index)));
                }

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'glossary-inline-term';
                btn.setAttribute('data-term-id', entry.id);
                btn.setAttribute('title', 'Click for C.S. Lewis illustration, definition & example');
                btn.textContent = matchedWord;
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    openGlossaryModal(entry.id);
                });

                frag.appendChild(btn);
                lastIdx = masterRegex.lastIndex;
                replacedAny = true;
            }

            if (replacedAny) {
                if (lastIdx < text.length) {
                    frag.appendChild(document.createTextNode(text.slice(lastIdx)));
                }
                textNode.parentNode?.replaceChild(frag, textNode);
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initGlossaryInteractions);
    } else {
        initGlossaryInteractions();
    }
</script>
